<Window x:Class="PungrangLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="풍랑빌 런처" Height="720" Width="1120"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#0D1B28" Foreground="#F4FAFF">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,24">
      <StackPanel>
        <TextBlock Text="PUNGRANGVILL" FontSize="13" Foreground="#78CBE2" FontWeight="Bold"/>
        <TextBlock Text="풍랑빌 런처" FontSize="30" FontWeight="Bold"/>
        <TextBlock Text="Minecraft 1.21.1 · NeoForge 21.1.265" Foreground="#A9BDCA" Margin="0,4,0,0"/>
      </StackPanel>
      <TextBlock x:Name="VersionText" Text="Launcher 0.1.0" Foreground="#A9BDCA"
                 HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="3*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#172B3B" CornerRadius="16" Padding="22" Margin="0,0,16,0">
        <StackPanel>
          <TextBlock Text="서버 상태" FontSize="21" FontWeight="Bold"/>
          <TextBlock x:Name="ServerStateText" Text="확인 전" FontSize="26" Foreground="#78CBE2" Margin="0,18,0,4"/>
          <TextBlock x:Name="PlayerCountText" Text="접속 인원 확인 전" Foreground="#B7C8D3"/>
          <TextBlock x:Name="MotdText" Text="서버 상태를 조회하려면 새로고침을 누르세요." TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#D5E1E8"/>
          <Button Content="서버 상태 새로고침" Click="RefreshServer_Click" Margin="0,22,0,0" HorizontalAlignment="Left"/>
          <Separator Margin="0,24" Background="#345064"/>
          <TextBlock Text="게임 설정" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="메모리 할당량 (GB)" Foreground="#B7C8D3" Margin="0,12,0,6"/>
          <ComboBox x:Name="MemoryCombo" SelectedIndex="1" Width="130" HorizontalAlignment="Left">
            <ComboBoxItem Content="2 GB"/>
            <ComboBoxItem Content="4 GB"/>
            <ComboBoxItem Content="6 GB"/>
            <ComboBoxItem Content="8 GB"/>
            <ComboBoxItem Content="10 GB"/>
            <ComboBoxItem Content="12 GB"/>
          </ComboBox>
          <TextBlock Text="계정 로그인과 게임 설치 기능은 다음 개발 단계에서 연결됩니다." TextWrapping="Wrap" Foreground="#91A9B8" Margin="0,18,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="#172B3B" CornerRadius="16" Padding="22">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="풍랑빌 소식" FontSize="21" FontWeight="Bold"/>
            <TextBlock Text="공지사항 및 업데이트 안내" Foreground="#A9BDCA" Margin="0,4,0,18"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AnnouncementsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#20394B" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"/>
                      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#C3D2DC" Margin="0,6,0,0"/>
                      <TextBlock Text="{Binding PublishedAt}" Foreground="#86A5B7" FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <DockPanel Grid.Row="2" Margin="0,22,0,0">
      <StackPanel>
        <TextBlock x:Name="StatusText" Text="준비됨" Foreground="#A9BDCA"/>
        <ProgressBar x:Name="ProgressBar" Height="5" Width="300" HorizontalAlignment="Left" Margin="0,8,0,0" Value="0"/>
      </StackPanel>
      <Button Content="게임 실행" Width="170" Height="48" FontSize="17" HorizontalAlignment="Right"
              IsEnabled="False" ToolTip="로그인 및 게임 설치 기능은 다음 단계에서 연결됩니다."/>
    </DockPanel>
  </Grid>
</Window>
